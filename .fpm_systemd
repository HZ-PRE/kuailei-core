-s dir
--name sdm-core
--category net
--license GPL-3.0-or-later
--description "The universal proxy platform."
--url "https://sdm.com/"
--maintainer "sdm <core@sdm.com>"
--deb-field "Bug: https://github.com/HZ-PRE/kuailei-core/issues"
--no-deb-generate-changes
--config-files /etc/sdm-core/config.json
--after-install release/config/sdm-core.postinst

release/config/config.json=/etc/sdm-core/config.json

release/config/sdm-core.service=/usr/lib/systemd/system/sdm-core.service
release/config/sdm-core@.service=/usr/lib/systemd/system/sdm-core@.service
release/config/sdm-core.sysusers=/usr/lib/sysusers.d/sdm-core.conf
release/config/sdm-core.rules=usr/share/polkit-1/rules.d/sdm-core.rules
release/config/sdm-core-split-dns.xml=/usr/share/dbus-1/system.d/sdm-core-split-dns.conf

LICENSE.md=/usr/share/licenses/sdm-core/LICENSE.md