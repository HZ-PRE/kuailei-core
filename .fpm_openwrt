-s dir
--name sdm-core
--category net
--license GPL-3.0-or-later
--description "The universal proxy platform."
--url "https://sdm.com/"
--maintainer "sdm <wrt@sdm.com>"
--no-deb-generate-changes

--config-files /etc/config/sdm
--config-files /etc/sdm/config.json

--depends ca-bundle
--depends kmod-inet-diag
--depends kmod-tun
--depends firewall4
--depends kmod-nft-queue

--before-remove release/config/openwrt.prerm

release/config/config.json=/etc/sdm/config.json

release/config/openwrt.conf=/etc/config/sdm
release/config/openwrt.init=/etc/init.d/sdm
release/config/openwrt.keep=/lib/upgrade/keep.d/sdm

LICENSE.md=/usr/share/licenses/sdm-core/LICENSE.md